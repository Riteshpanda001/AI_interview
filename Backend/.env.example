# =========================================================
# PreNova AI — Backend Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =========================================================

# ─── Application ─────────────────────────────────────────
APP_NAME="AI Interview Preparation System"
DEBUG=True
PORT=8000
HOST="0.0.0.0"
FRONTEND_URL="http://localhost:5173"

# ─── JWT / Auth ──────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET="change-me-to-a-strong-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── MongoDB ─────────────────────────────────────────────
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="ai_interview_prep"

# ─── Redis ───────────────────────────────────────────────
# Redis is used for OTP storage, rate-limiting, and session blacklisting.
# Set REDIS_REQUIRED=true in production to fail fast if Redis is unavailable.
REDIS_URL="redis://127.0.0.1:6379/0"
REDIS_REQUIRED=false

# ─── AI / LLM API Keys ───────────────────────────────────
# At least one of Gemini or Groq is required for AI interview/resume features.
GEMINI_API_KEY=""
GROQ_API_KEY=""
HUGGINGFACE_API_KEY=""
HUGGINGFACE_MODEL="meta-llama/Llama-3.2-3B-Instruct"

# ─── Google OAuth ────────────────────────────────────────
GOOGLE_CLIENT_ID=""

# ─── SMTP / Email ────────────────────────────────────────
# Option 1: Gmail (requires App Password — enable 2FA first)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_EMAIL=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL=""
EMAILS_FROM_NAME="PreNova AI"

# ─── SMS Provider ────────────────────────────────────────
# Supported: console | twilio | msg91 | fast2sms
# Use "console" for development (OTP printed to terminal).
SMS_PROVIDER="console"

# Twilio (SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# MSG91 (SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""

# Fast2SMS (SMS_PROVIDER=fast2sms)
FAST2SMS_API_KEY=""

# ─── Payment Gateways ────────────────────────────────────
# Razorpay (primary gateway for INR payments)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Stripe (USD / international payments)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
