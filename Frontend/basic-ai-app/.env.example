# =========================================================
# PreNova AI — Frontend Environment Configuration (Vite)
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# All variables must start with VITE_ to be accessible in browser.
# =========================================================

# ─── API Base URL ────────────────────────────────────────
# URL of the running backend (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api

# ─── Google OAuth ────────────────────────────────────────
VITE_GOOGLE_CLIENT_ID=

# ─── Razorpay (Payment Gateway) ──────────────────────────
# Only the PUBLIC key is safe to expose in the frontend.
# The secret key must stay on the backend only.
VITE_RAZORPAY_KEY_ID=
